# Configuración de Conexión a PostgreSQL 18 Local (PsychoTrack DB)
# Si deseas conectar al servicio PostgreSQL 18 instalado en tu Windows, actualiza la contraseña de 'postgres' aquí:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/psychotrack_db

# Llave criptográfica simétrica para cifrado a nivel de columna (pgcrypto AES-256)
PGCRYPTO_CLINICAL_KEY=PsychoTrack_AES256_ClinicalKey_2026!

# Configuración de API de Notificación de Emergencia (SendGrid / SMTP Supervisor Clínico)
SMTP_SUPERVISOR_EMAIL=roberto.guzman@psychotrack.udg.mx
SENDGRID_API_ENABLED=true
